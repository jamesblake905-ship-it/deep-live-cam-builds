diff --git a/run.py b/run.py
index a0571c2..1c7417f 100644
--- a/run.py
+++ b/run.py
@@ -3,6 +3,32 @@
 import os
 import sys
 
+if __name__ == "__main__":
+    import multiprocessing
+    multiprocessing.freeze_support()
+
+# Resolve all assets relative to the app; writable state belongs to its user.
+if getattr(sys, "frozen", False):
+    executable_dir = os.path.dirname(sys.executable)
+    state = os.environ.get("DLC_DATA_DIR") or os.path.expanduser("~/Library/Application Support/DeepLiveCam")
+    os.makedirs(state, exist_ok=True)
+    os.environ["PATH"] = executable_dir + os.pathsep + "/usr/bin:/bin:/usr/sbin:/sbin"
+    os.environ["MPLCONFIGDIR"] = os.path.join(state, "matplotlib")
+    os.environ["MPLBACKEND"] = "Agg"
+    os.environ["KERAS_BACKEND"] = "torch"
+    os.environ["KERAS_HOME"] = os.path.join(state, "keras")
+    os.environ["OPENNSFW2_HOME"] = os.path.join(sys._MEIPASS, "opennsfw2-data")
+    os.environ["DLC_MODEL_CACHE"] = os.path.join(state, "models-f8f9b85")
+    os.environ["NO_ALBUMENTATIONS_UPDATE"] = "1"
+    os.makedirs(os.environ["MPLCONFIGDIR"], exist_ok=True)
+    os.chdir(state)
+    if len(sys.argv) == 1:
+        sys.argv.extend(["--execution-provider", "coreml", "--det-size", "320", "--execution-threads", "4"])
+        log_fd = os.open(os.path.join(state, "application.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
+        os.dup2(log_fd, 1)
+        os.dup2(log_fd, 2)
+        os.close(log_fd)
+
 # Add the project root to PATH so bundled ffmpeg/ffprobe are found
 project_root = os.path.dirname(os.path.abspath(__file__))
 os.environ["PATH"] = project_root + os.pathsep + os.environ.get("PATH", "")
